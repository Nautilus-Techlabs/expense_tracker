{
  "version": "1.0",
  "banks": [
    {
      "bankName": "HDFC Bank",
      "senderIdentifiers": ["HDFCBK", "HDFC-BANK", "JD-HDFCBK", "HDFC"],
      "templates": [

        {
          "name": "HDFC Atomic 1 (Spent First)",
          "pattern": "(?:Spent|Txn|Txn of)\\s+(?:Rs\\.?|INR)\\s*([0-9,]+(?:\\.\\d{2})?)\\s+(?:.*?Card\\s+(?:ending\\s+)?([\\dX*]+))?.*?at\\s+([^\\.\\n;]+?)(?=\\s+on\\s+|\\.|\\n|$|;)",
          "type": "debit",
          "amountGroup": 1,
          "accountGroup": 2,
          "merchantGroup": 3,
          "method": "card",
          "priority": 1
        },
        {
          "name": "HDFC Atomic 2 (Alert Style)",
          "pattern": "(?:Card\\s+(?:ending\\s+)?([\\dX*]+))?.*?debited\\s+for\\s+(?:Rs\\.?|INR)\\s*([0-9,]+(?:\\.\\d{2})?)\\s+at\\s+([^\\.\\n;]+?)(?=\\s+on\\s+|\\.|\\n|$|;)",
          "type": "debit",
          "amountGroup": 2,
          "accountGroup": 1,
          "merchantGroup": 3,
          "method": "card",
          "priority": 2
        },
        {
          "name": "HDFC Atomic 3 (Amount First Spend)",
          "pattern": "(?:INR|Rs\\.?)\\s*([0-9,]+(?:\\.\\d{2})?)\\s+spent\\s+on\\s+(?:.*?Card\\s+(?:ending\\s+)?([\\dX*]+))?\\s+at\\s+([^\\.\\n;]+?)(?=\\s+on\\s+|\\.|\\n|$|;)",
          "type": "debit",
          "amountGroup": 1,
          "accountGroup": 2,
          "merchantGroup": 3,
          "method": "card",
          "priority": 3
        },
        {
          "name": "HDFC Atomic 4 (UPI Precision)",
          "pattern": "(?:UPI|VPA).*?(?:Rs\\.?|INR)\\s*([0-9,]+(?:\\.\\d{2})?).*?(?:from\\s+(?:your\\s+)?A/c\\s+([\\dX*]+))?.*?(?:at|to)\\s+([^\\.\\n;]+?)(?=\\s+on\\s+|\\.|\\n|$|;)",
          "type": "debit",
          "amountGroup": 1,
          "accountGroup": 2,
          "merchantGroup": 3,
          "method": "upi",
          "priority": 4
        },
        {
          "name": "HDFC Atomic 5 (Simple Debit)",
          "pattern": "(?:Rs\\.?|INR)\\s*([0-9,]+(?:\\.\\d{2})?)\\s+debited.*?(?:A/c\\s+([\\dX*]+))?.*?at\\s+([^\\.\\n;]+?)(?=\\s+on\\s+|\\.|\\n|$|;)",
          "type": "debit",
          "amountGroup": 1,
          "accountGroup": 2,
          "merchantGroup": 3,
          "method": "unknown",
          "priority": 5
        },
        {
          "name": "HDFC Universal Safety-Net",
          "pattern": "(?:debited|spent|credited|received).*?(?:Rs\\.?|INR|₹)\\s*([0-9,]+(?:\\.\\d{2,})?).*?(?:account|A/c|Card|XX|\\*\\*)?\\s*([\\dX*]+)?",
          "type": "debit",
          "amountGroup": 1,
          "accountGroup": 2,
          "priority": 25
        }
      ]
    },
    {
      "bankName": "ICICI Bank",
      "senderIdentifiers": ["ICICIB", "ICICI-BANK", "ICICIBANK", "ICICI"],
      "templates": [
        {
          "name": "ICICI Card Txn",
          "pattern": "(?:Transaction\\s+for|Txn\\s+of)\\s+(?:Rs\\.?|INR)\\s*([0-9,]+(?:\\.\\d+)?)\\s+(?:done\\s+)?on\\s+ICICI\\s+(?:Bank\\s+)?Card\\s+(?:xx)?([\\dX*]+)\\s+at\\s+([^\\.\\n;]+?)(?=\\s+on\\s+|\\.|\\n|$|;)",
          "type": "debit",
          "amountGroup": 1,
          "accountGroup": 2,
          "merchantGroup": 3,
          "method": "card"
        },
        {
          "name": "ICICI VPA Debit",
          "pattern": "(?:your\\s+)?ICICI\\s+Bank\\s+A/c\\s+([\\dX*]+)\\s+debited\\s+for\\s+(?:INR|Rs\\.?)\\s*([0-9,]+(?:\\.\\d+)?).*?VPA\\s+([^\\s\\.;]+)",
          "type": "debit",
          "amountGroup": 2,
          "accountGroup": 1,
          "merchantGroup": 3,
          "method": "upi"
        },
        {
          "name": "ICICI POS Debit",
          "pattern": "(?:Rs\\.?|INR)\\s*([0-9,]+(?:\\.\\d+)?)\\s+debited\\s+from\\s+(?:your\\s+)?A/c\\s+([\\dX*]+)\\s+at\\s+([^\\.\\n;]+?)(?=\\s+on\\s+|\\s+via\\s+|\\.\\s+|$|;).*?\\s+via\\s+POS",
          "type": "debit",
          "amountGroup": 1,
          "accountGroup": 2,
          "merchantGroup": 3,
          "method": "card"
        },
        {
          "name": "ICICI POS Debit Alt",
          "pattern": "(?:Rs\\.?|INR)\\s*([0-9,]+(?:\\.\\d+)?)\\s+debited\\s+from\\s+(?:your\\s+)?A/c\\s+([\\dX*]+)\\s+via\\s+POS\\s+at\\s+([^\\.\\n;]+?)(?=\\s+on\\s+|\\.|\\n|$|;)",
          "type": "debit",
          "amountGroup": 1,
          "accountGroup": 2,
          "merchantGroup": 3,
          "method": "card"
        },
        {
          "name": "ICICI Debit Info Flex",
          "pattern": "(?:A/c|Acct|Bank).*?([\\dX*]+)\\s+debited\\s+(?:for|by|INR|Rs\\.?|with)\\s*([0-9,]+(?:\\.\\d+)?).*?(?:Info:|at|to)\\s*(?:UPI/)?([^\\.\\s]+)",
          "type": "debit",
          "amountGroup": 2,
          "accountGroup": 1,
          "merchantGroup": 3,
          "method": "unknown"
        },
        {
          "name": "ICICI General Info",
          "pattern": "A/c\\s+([\\dX*]+)\\s+debited\\s+(?:for|by|INR|Rs\\.?)\\s*([0-9,]+(?:\\.\\d+)?).*?(?:IMPS|NEFT)/([^/]+)/",
          "type": "debit",
          "amountGroup": 2,
          "accountGroup": 1,
          "merchantGroup": 3,
          "method": "unknown"
        },
        {
          "name": "ICICI Withdrawal",
          "pattern": "(?:Rs\\.?|INR)\\s*([0-9,]+(?:\\.\\d+)?)\\s+withdrawn\\s+from\\s+(?:A/c|Acct)\\s+([\\dX*]+)",
          "type": "debit",
          "amountGroup": 1,
          "accountGroup": 2,
          "method": "atm"
        },
        {
          "name": "ICICI Credit Flex",
          "pattern": "(?:A/c|Acct|Bank).*?([\\dX*]+)\\s+credited\\s+(?:with|by|for)\\s+(?:INR|Rs\\.?)\\s*([0-9,]+(?:\\.\\d+)?)(?:.*?Info:\\s*([^\\s\\.;]+))?",
          "type": "credit",
          "amountGroup": 2,
          "accountGroup": 1,
          "merchantGroup": 3,
          "method": "unknown"
        },
        {
          "name": "ICICI Receive",
          "pattern": "(?:Rs\\.?|INR)\\s*([0-9,]+(?:\\.\\d+)?)\\s+received\\s+(?:via\\s+)?.*?(?:A/c|UPI|Ref No)[^\\d]*?([\\dX*]+)?",
          "type": "credit",
          "amountGroup": 1,
          "accountGroup": 2,
          "method": "unknown"
        },
        {
          "name": "ICICI Universal Safety-Net",
          "pattern": "(?:debited|spent|credited|withdrawn|received).*?(?:Rs\\.?|INR|₹)\\s*([0-9,]+(?:\\.\\d{2,})?).*?(?:A/c|Acct|account|Card|XX|\\*\\*)\\s*([\\dX*]+)",
          "type": "debit",
          "amountGroup": 1,
          "accountGroup": 2,
          "priority": 20
        }
      ]
    },
    {
